<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' pos-receipt ')]" position="attributes">
            <attribute name="t-att-class">ffReceiptClass</attribute>
            <attribute name="t-att-style">ffReceiptStyle</attribute>
            <attribute name="dir">auto</attribute>
        </xpath>
    </t>
</templates>
